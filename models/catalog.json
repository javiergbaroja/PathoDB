    ],
    "classes": ["Nerve", "PNI-positive nerve", "Tumour"],
    "params": [
      {
        "key": "tile_size",
        "label": "Patch size (px)",
        "type": "int",
        "default": 336,
        "options": [224, 336, 448, 560]
      },
      {
        "key": "tile_overlap",
        "label": "Tile overlap (%)",
        "type": "int",
        "default": 66,
        "options": [25, 33, 50, 66, 75]
      },
      {
        "key": "use_tissue_mask",
        "label": "Use automated tissue mask",
        "type": "bool",
        "default": 1,
        "options": [0, 1]
      },
      {
        "key": "tissue_mask_dilation_um",
        "label": "Tissue-mask fat dilation (µm)",
        "type": "int",
        "default": 500,
        "options": [0, 250, 500, 1000]
      },
      {
        "key": "reuse_segmentation",
