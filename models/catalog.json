[
  {
    "id": "metassist_v2",
    "name": "MetAssist v2",
    "description": "Two-stage lymph node metastasis detector.\nStage 1 segments lymph nodes at low resolution; Stage 2 detects metastatic deposits within each node at full resolution.\nOutputs colour-coded overlays for LN boundaries and metastasis deposits, and a slide-level positive/negative call with maximum extent in mm.",
    "category": "Detection",
    "supports_batch": true,
    "stain_compatibility": ["HE"],
    "estimated_minutes": 15,
    "result_type": "ln_metastasis",
    "classes": ["Lymph node", "Tumor deposits", "Primary tissue", "Fat tissue", "Vessels", "Mucin", "Metastasis"],
    "params": [
      {
        "key": "met_tile_size",
        "label": "Patch size (px)",
        "type": "int",
        "default": 336,
        "options": [224, 336, 448, 560]
      },
      {
        "key": "met_tile_overlap",
        "label": "Tile overlap (%)",
        "type": "int",
        "default": 66,
        "options": [25, 33, 50, 66, 75]
      }
    ]
  },
  {
    "id": "crc_tissue_segmentation",
    "name": "CRC Tissue Segmentation",
    "description": "Segments tissue into tumor, stroma, necrosis, lymphoid tissue, mucous, normal mucosa, muscle (including vessels). \nOutputs a colour-coded overlay and per-zone area fractions.",
    "category": "Segmentation",
    "supports_batch": true,
    "stain_compatibility": ["HE"],
    "classes": ["Fat", "Normal Mucosa", "Lymphoid tissue", "Stroma", "Mucous", "Tumor", "Necrosis/debris", "Muscle/vessel", "Nerve", "Blood"],
    "estimated_minutes": 8,
    "result_type": "segmentation",
    "params": [
      {
        "key": "tile_size",
        "label": "Patch size (px)",
        "type": "int",
        "default": 336,
        "options": [224, 336, 448, 560]
      },
      {
        "key": "tile_overlap",
        "label": "Tile overlap (%)",
        "type": "int",
        "default": 66,
        "options": [25, 33, 50, 66, 75]
      },
      {
        "key": "use_tissue_mask",
        "label": "Use automated tissue mask",
        "type": "bool",
        "default": 1,
        "options": [0, 1]
      },
      {
        "key": "tissue_mask_dilation_um",
        "label": "Tissue-mask fat dilation (µm)",
        "type": "int",
        "default": 0,
        "options": [0, 250, 500, 1000]
      }
    ]
  },
  {
    "id": "hover_next",
    "name": "HoVer-NeXt",
    "description": "Fast and efficient nuclei segmentation and classification pipeline. Identifies and phenotypically classifies individual cells.",
    "category": "Detection",
    "supports_batch": true,
    "stain_compatibility": ["HE"],
    "estimated_minutes": 15,
    "result_type": "multiclass_detection",
    "classes":  [ "neutrophil", "epithelial-cell", "lymphocyte", "plasma-cell", "eosinophil", "connective-tissue-cell", "mitosis" ],
    "params": [
      {
        "key": "cp",
        "label": "Model Weights",
        "type": "string",
        "default": "lizard_convnextv2_large",
        "options": ["lizard_convnextv2_large", "pannuke_convnextv2_large"]
      },
      {
        "key": "tta",
        "label": "Test-Time Augmentation",
        "type": "int",
        "default": 8,
        "options": [2, 4, 8, 16]
      },
      {
        "key": "pp_tiling",
        "label": "Post-Processing Tiling",
        "type": "int",
        "default": 8,
        "min": 2,
        "max": 32,
        "step": 2
      }
    ]
  },
    {
    "id": "virchow2",
    "name": "Virchow2",
    "description": "Paige AI foundation model for whole-slide image feature extraction.\nExtracts tile-level embeddings (1280-dim CLS + register mean) at the specified resolution and saves them as a compressed .npz file per slide.\nOutputs are suitable for downstream MIL classification, clustering, and retrieval tasks.",
    "category": "Feature Extraction",
    "supports_batch": true,
    "stain_compatibility": [
      "HE",
      "IHC"
    ],
    "estimated_minutes": 20,
    "result_type": "feature_extraction",
    "classes": [],
    "params": [
      {
        "key": "tile_size",
        "label": "Tile size (px)",
        "type": "int",
        "default": 224,
        "options": [
          224,
          336,
          448
        ]
      },
      {
        "key": "resolution",
        "label": "Resolution (µm/px)",
        "type": "float",
        "default": 1.0,
        "options": [
          0.25,
          0.5,
          1,
          2
        ]
      }
    ]
  },
  {
    "id": "crc_invasion_extent",
    "name": "CRC Extent of Invasion (pT)",
    "description": "CRC Clinical suite — reuses the CRC Tissue Segmentation backbone to read the ICCR 'Extent of invasion' element.\nSegments the bowel wall (tumour / muscularis propria / pericolic fat / mucosa), then estimates a pT category and the depth of invasion beyond the muscularis propria in mm.\nRun on the deepest, transmural tumour block. pTis/pT1 are not separated (submucosa not resolved) and pT4a/pT4b require gross/serosal correlation.",
    "category": "CRC Clinical",
    "supports_batch": false,
    "stain_compatibility": ["HE"],
    "estimated_minutes": 8,
    "result_type": "invasion_extent",
    "produces": [
      {
        "as_model": "crc_tissue_segmentation",
        "artifact": "tissue_segmentation",
        "artifact_key": "tissue_geojson",
        "overlay_key": "raster_overlay_tissue",
        "overlay_name": "Tissue Classes",
        "composition_key": "tissue_composition_pct",
        "derived_status": "segmentation_complete",
        "only_if_fresh_field": "segmentation_source",
        "only_if_fresh_value": "fresh_inference"
      }
    ],
    "reuses": [
      {
        "from_model": "crc_tissue_segmentation",
        "artifact": "tissue_segmentation",
        "toggle": "reuse_segmentation",
        "inject": "_reuse_seg_geojson"
      }
    ],
    "classes": ["Muscularis propria", "Intramural tumour", "Tumour beyond MP"],
    "params": [
      {
        "key": "tile_size",
        "label": "Patch size (px)",
        "type": "int",
        "default": 336,
        "options": [224, 336, 448, 560]
      },
      {
        "key": "tile_overlap",
        "label": "Tile overlap (%)",
        "type": "int",
        "default": 66,
        "options": [25, 33, 50, 66, 75]
      },
      {
        "key": "use_tissue_mask",
        "label": "Use automated tissue mask",
        "type": "bool",
        "default": 1,
        "options": [0, 1]
      },
      {
        "key": "tissue_mask_dilation_um",
        "label": "Tissue-mask fat dilation (µm)",
        "type": "int",
        "default": 500,
        "options": [0, 250, 500, 1000]
      },
      {
        "key": "reuse_segmentation",
        "label": "Reuse existing segmentation if available",
        "type": "bool",
        "default": 0,
        "options": [0, 1]
      },
      {
        "key": "min_tumor_um",
        "label": "Min tumour object size (µm)",
        "type": "int",
        "default": 300,
        "options": [150, 300, 500, 1000]
      },
      {
        "key": "adjacency_um",
        "label": "Tumour–tissue adjacency radius (µm)",
        "type": "int",
        "default": 120,
        "options": [60, 120, 200, 300]
      }
    ]
  },
  {
    "id": "crc_perineural_invasion",
    "name": "CRC Perineural Invasion",
    "description": "CRC Clinical suite — reuses the CRC Tissue Segmentation backbone to read the ICCR 'Perineural invasion' element.\nFor each nerve, calls PNI when tumour surrounds ≥33% of its circumference or invades it, and reports the number of nerves involved.\nRun on tumour blocks. Screening detection on HE — a negative is not definitive; S100/SOX10 IHC can confirm equivocal foci. Set 'Reuse existing segmentation' to skip re-inference when a CRC tissue segmentation already exists for the slide.",
    "category": "CRC Clinical",
    "supports_batch": false,
    "stain_compatibility": ["HE"],
    "estimated_minutes": 8,
    "result_type": "perineural_invasion",
    "produces": [
